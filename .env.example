# =================================================================
# Groww API & Autonomous Trading Configuration
# =================================================================

# Groww Developer API Credentials (Optional - leave empty for Paper Trading)
GROWW_API_KEY=
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=

# Auto Trading Engine Settings
AUTO_TRADE_ENABLED=true
DRY_RUN=true                    # Set to false for live broker order placement
ACCOUNT_CAPITAL=100000          # Trading account capital in INR
MAX_RISK_PER_TRADE_PCT=1.0      # Max risk per trade (e.g. 1.0 = 1%)
MAX_TRADES_PER_DAY=3            # Safety circuit-breaker: Max orders placed per day
MIN_EXPECTANCY_R=0.35           # Minimum positive mathematical expectancy threshold (+R)
MIN_TARGET_ODDS_PCT=52.0        # Minimum bootstrap Monte Carlo target-first odds %

# Daily Autonomous Watchlist (Comma-separated symbols)
WATCHLIST=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS,SBIN.NS,KALYANKJIL.NS
